# --- Base de données ---
DATABASE_URL=postgresql://editor_user:Postgres.2424@localhost:5432/editor_db
POSTGRES_USER=editor_user
POSTGRES_DB=editor_db
# --- Sécurité ---
SECRET_KEY=GMwT7yI0ryNyDQGPKMdTvtBmMAPs3ILVvITi4Q9uPWY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Réseau ---
CORS_ORIGINS=http://localhost:3000

# --- Environnement : development | production ---
ENVIRONMENT=development

# --- Stockage des fichiers : local | s3 ---
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# # Si STORAGE_BACKEND=s3 :
# S3_BUCKET=
# S3_REGION=eu-west-3
# S3_PUBLIC_BASE_URL=

# --- Limitation de débit ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_UPLOAD=30/minute

# --- URL publique du frontend (utilisée dans les emails envoyés) ---
FRONTEND_URL=http://localhost:3000

# --- Envoi d'emails (mot de passe oublié, invitations) ---
# Laissez SMTP_HOST vide en développement : les emails seront journalisés
# dans la console au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Atelier <no-reply@votredomaine.com>
SMTP_USE_TLS=true
